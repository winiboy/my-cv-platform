# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries no real values, only placeholders, and documents the
# required variables (GROQ_API_KEY, GROQ_MODEL, ...). The blanket rule above
# hid it, so the documentation could never reach anyone.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Sentry Config File
.env.sentry-build-plugin

# Test artifacts
lint-report.txt
rls-audit-output.txt

# Governance approval mode — per-developer session state, not repo config.
# A fresh clone has no state file, which the hook reads as STANDARD. That is
# the intended fallback: absent state must never grant anything.
.claude/governance-state.json

# E2E build output (see playwright.config.ts)
.next-e2e/
test-results/
playwright-report/

# Verification build output (see scripts/build-verify.mjs)
.next-verify/
