# ==============================================================================
# SUPABASE CONFIGURATION (REQUIRED)
# ==============================================================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# APP BASE URL (RECOMMENDED)
# ==============================================================================
# Used as the canonical origin for OAuth callback URLs.
# Required when running the dev server with --hostname 0.0.0.0 to avoid
# ERR_ADDRESS_INVALID errors in the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# NEXTAUTH CONFIGURATION
# ==============================================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# ==============================================================================
# OAUTH PROVIDERS (OPTIONAL)
# ==============================================================================
# GitHub OAuth was removed — only Google OAuth is used

# ==============================================================================
# GROQ AI (REQUIRED - powers every AI tool)
# ==============================================================================
# Get an API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Model ids are configurable because Groq retires hosted models on its own
# schedule, and a retired id makes every AI tool fail with `model_not_found`.
# Leave these unset to use the defaults compiled into src/lib/ai/client.ts.
# When a model is retired, check https://console.groq.com/docs/models for a
# current id and set it here - no code change or redeploy of new code required.
#
# GROQ_MODEL      - default/balanced/quality model (default: openai/gpt-oss-120b)
# GROQ_MODEL_FAST - lower-latency model            (default: openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# ==============================================================================
# ADZUNA JOB API (OPTIONAL - for real Swiss job listings)
# ==============================================================================
# Sign up at: https://developer.adzuna.com/
# Free tier: 5000 API calls per month
# If not configured, the app will use mock job data
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# ==============================================================================
# GIT BRANCH INDICATOR (AUTO-INJECTED)
# ==============================================================================
# This variable is automatically set at build time from the current Git branch.
# On Vercel, it uses VERCEL_GIT_COMMIT_REF instead.
# You do NOT need to set this manually.
# NEXT_PUBLIC_GIT_BRANCH=feature/my-branch
